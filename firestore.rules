rules_version = '2';

// Reglas de seguridad de Firestore para la coleccion "tasks".
// El filtrado por userId en el cliente (taskService.js) alcanza para
// la UI, pero la separacion real entre usuarios la garantiza esto:
// nadie puede leer ni escribir un documento cuyo userId no sea el
// suyo, ni siquiera pegandole directo a la API de Firestore.
service cloud.firestore {
  match /databases/{database}/documents {
    match /tasks/{taskId} {
      allow read, update, delete: if request.auth != null
        && request.auth.uid == resource.data.userId;

      allow create: if request.auth != null
        && request.auth.uid == request.resource.data.userId;
    }

    // Documento de perfil (avatar). El id del documento es el uid
    // del usuario, asi que alcanza con compararlo contra quien hace
    // el pedido: nadie puede leer ni escribir el perfil de otro.
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
